# Copy this file to .env and fill in your values. Never commit .env.
# Lines starting with # are defaults you can uncomment and change.

# --- Answer model ---------------------------------------------------------
HF_TOKEN=your_huggingface_token
# LLM_PROVIDER=huggingface            # or ollama
# HF_LLM_MODEL=openai/gpt-oss-20b
# HF_VERIFIER_MODEL=                  # a second model that checks answers
# LLM_MAX_TOKENS=1536

# Ollama (only with LLM_PROVIDER=ollama; HF_TOKEN not needed)
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192
# OLLAMA_VERIFIER_MODEL=

# Answer checker: llm (default) or local_ensemble (run download_models.py first)
# GROUNDING_CHECKER=llm

# --- Saving conversations (PostgreSQL) -----------------------------------
# DATABASE_URL=postgresql://ytchat:your_password@localhost:5432/ytchat
# CHAT_RETENTION_DAYS=30
# BROWSER_STATE_SECRET=               # optional; otherwise kept in the database

# --- YouTube ---------------------------------------------------------------
# YOUTUBE_PROXY=http://user:password@proxy.example.com:8080

# --- Limits ------------------------------------------------------------------
# MAX_QUESTION_CHARS=1000
# MAX_VIDEO_MINUTES=180
# MAX_TRANSCRIPT_CHARS=250000
# MAX_VIDEOS_PER_HOUR=20
# MAX_QUESTIONS_PER_HOUR=120
# SESSION_IDLE_MINUTES=120
# MAX_SESSIONS=50
# MAX_CHATS_PER_SESSION=10
# MAX_CONCURRENT_REQUESTS=4

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL=INFO
